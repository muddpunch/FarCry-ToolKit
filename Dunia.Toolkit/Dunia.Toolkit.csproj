<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dunia.Toolkit</RootNamespace>
    <ApplicationIcon>..\assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dunia.Formats/Dunia.Formats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\data\fcb-schema.fc5.txt" Link="data\fcb-schema.fc5.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\data\fcb-names.fc5.txt" Link="data\fcb-names.fc5.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
