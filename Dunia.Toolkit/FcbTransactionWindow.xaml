<Window x:Class="Dunia.Toolkit.FcbTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCB transaction"
        Width="1180"
        Height="740"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#101010"
        Foreground="#F2F2F2">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101010" />
        <SolidColorBrush x:Key="PanelBrush" Color="#181818" />
        <SolidColorBrush x:Key="ControlBrush" Color="#242424" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A6A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3978AE" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#5794C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background" Value="#202F3C" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2E5D87" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Loading FCB schema..." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="FCB transaction API v1" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top"
                Padding="16,12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ResourceTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ResourceIdentityText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="LoadSchemaButton"
                            HorizontalAlignment="Right"
                            Click="LoadSchemaClick"
                            Content="Load schema..."
                            AutomationProperties.Name="Load FCB value schema" />
                    <TextBlock x:Name="SchemaPathText"
                               MaxWidth="420"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="FieldsGrid"
                      Margin="12"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True"
                      Background="{StaticResource WindowBrush}"
                      Foreground="{StaticResource TextBrush}"
                      RowBackground="{StaticResource WindowBrush}"
                      AlternatingRowBackground="#191919"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      AutomationProperties.Name="Editable FCB fields">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46" Header="State" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#73B9F2"
                                           Text="{Binding State}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="70" Header="Entry" Binding="{Binding EntryIndex}" IsReadOnly="True" />
                    <DataGridTextColumn Width="180" Header="Resource" Binding="{Binding ResourceName}" IsReadOnly="True" />
                    <DataGridTextColumn Width="70" Header="Node" Binding="{Binding NodeIndex}" IsReadOnly="True" />
                    <DataGridTextColumn Width="70" Header="Field" Binding="{Binding FieldIndex}" IsReadOnly="True" />
                    <DataGridTextColumn Width="150" Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" />
                    <DataGridTextColumn Width="105" Header="Type hash" Binding="{Binding TypeHash}" IsReadOnly="True" />
                    <DataGridTextColumn Width="150" Header="Name" Binding="{Binding FieldName}" IsReadOnly="True" />
                    <DataGridTextColumn Width="105" Header="Field hash" Binding="{Binding FieldHash}" IsReadOnly="True" />
                    <DataGridTextColumn Width="145" Header="Codec" Binding="{Binding Codec}" IsReadOnly="True" />
                    <DataGridTextColumn Width="2*" MinWidth="180" Header="Current" Binding="{Binding OriginalValue}" IsReadOnly="True" />
                    <DataGridTextColumn Width="2*" MinWidth="180" Header="Pending value">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Value" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Padding="14,12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Pending:" />
                        <TextBlock x:Name="PendingCountText" Margin="5,0,18,0" FontWeight="SemiBold" Text="0" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Plan:" />
                        <TextBlock x:Name="PlanStateText" Margin="5,0,0,0" FontWeight="SemiBold" Text="not created" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="DiscardButton" Margin="0,0,8,0" Click="DiscardClick" Content="Discard" IsEnabled="False" />
                        <Button x:Name="PlanButton" Margin="0,0,8,0" Click="PlanClick" Content="Plan" IsEnabled="False" />
                        <Button x:Name="DryRunButton" Margin="0,0,8,0" Click="DryRunClick" Content="Dry-run" IsEnabled="False" />
                        <Button x:Name="CreateCopyButton" Margin="0,0,8,0" Click="CreateCopyClick" Content="Create copy..." IsEnabled="False" />
                        <Button x:Name="ApplyButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="ApplyClick"
                                Content="Apply"
                                IsEnabled="False"
                                AutomationProperties.HelpText="Creates immutable original backups before writing" />
                        <Button x:Name="CancelButton" Margin="8,0,0,0" Click="CancelClick" Content="Cancel" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock x:Name="PlanHashText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,9,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas"
                               Text="Plan SHA-256: -"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
