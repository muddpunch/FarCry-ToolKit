<Window x:Class="Dunia.Toolkit.MeshPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesh preview"
        Width="1040"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#101010"
        Foreground="#F2F2F2"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818" />
        <SolidColorBrush x:Key="ControlBrush" Color="#242424" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5EA9E6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A6A6" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="14,10"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MeshNameText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeshStatsText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Label VerticalContentAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Target="{Binding ElementName=LodSelector}"
                           Content="_LOD:" />
                    <ComboBox x:Name="LodSelector"
                              Width="240"
                              Margin="6,0,0,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="LodSelectionChanged"
                              AutomationProperties.Name="Mesh level of detail" />
                </StackPanel>
                <Button Grid.Column="2"
                        Margin="16,0,0,0"
                        Click="ResetViewClick"
                        Content="Reset view"
                        AutomationProperties.Name="Reset 3D camera" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Click="ExportFbxClick"
                        Content="Export _FBX..."
                        AutomationProperties.Name="Export all mesh levels of detail to FBX" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="12,7"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="LOD: [ / ]   Orbit: left drag / arrows   Pan: right drag / Shift+arrows   Zoom: wheel / +/-   Reset: Home   Close: Esc" />
        </Border>

        <GroupBox DockPanel.Dock="Right"
                  Width="300"
                  Margin="0,12,12,12"
                  Padding="6"
                  Header="Material references">
            <ListView x:Name="MaterialsList"
                      Background="{StaticResource ControlBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      AutomationProperties.Name="Mesh material references">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="100" Header="Name" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Width="160" Header="Path" DisplayMemberBinding="{Binding Path}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <Border x:Name="ViewportBorder"
                Margin="12"
                Background="#080A0C">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewport3D x:Name="MeshViewport"
                        Focusable="True"
                        ClipToBounds="True"
                        MouseDown="ViewportMouseDown"
                        MouseMove="ViewportMouseMove"
                        MouseUp="ViewportMouseUp"
                        MouseWheel="ViewportMouseWheel"
                        LostMouseCapture="ViewportLostMouseCapture"
                        AutomationProperties.Name="Interactive 3D mesh preview"
                        AutomationProperties.HelpText="Use arrow keys to orbit, Shift plus arrow keys to pan, plus and minus to zoom, Home to reset, and Escape to close.">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" FieldOfView="42" />
                </Viewport3D.Camera>
            </Viewport3D>
        </Border>
    </DockPanel>
</Window>
